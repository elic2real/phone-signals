{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codespaces_rcp/schemas/structure_truth.schema.json",
  "title": "structure_truth",
  "type": "object",
  "required": ["artifact", "metadata", "key", "structure"],
  "properties": {
    "artifact": { "const": "structure_truth.json" },
    "metadata": {
      "type": "object",
      "required": ["owner", "stage", "generated_at"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "enum": ["phase2"] },
        "generated_at": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "key": {
      "type": "object",
      "required": ["direction", "target_bucket", "pair", "session"],
      "properties": {
        "direction": { "type": "string" },
        "target_bucket": { "type": "string" },
        "pair": { "type": "string" },
        "session": { "type": "string" },
        "path_family": { "type": "string" }
      },
      "additionalProperties": true
    },
    "structure": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
