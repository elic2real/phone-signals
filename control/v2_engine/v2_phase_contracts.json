{
  "artifact_id": "V2_PHASE_CONTRACTS",
  "version": "1.1",
  "phases": [
    {
      "phase": "PHASE_1",
      "name": "Tier 0 Physics Engine",
      "required_outputs": [
        "control/v2_engine/phase1/v2_phase1_execution_report.json",
        "control/v2_engine/phase1/v2_phase1_sample_profiles.json",
        "control/v2_engine/phase1/v2_phase1_scenario_summary.json",
        "control/v2_engine/phase1/v2_phase1_discovery_map.json"
      ],
      "pass_gates": [
        "all scenarios produce sanitized output",
        "no unhandled NaN or Infinity in synthesized profiles",
        "at least one spread anomaly is detected in spread stress scenarios",
        "at least one compression state and one expansion state are observed across the run"
      ],
      "input_schema": {
        "tick_fields": [
          "instrument",
          "ts",
          "bid",
          "ask"
        ],
        "optional_fields": [
          "mid",
          "volume"
        ]
      },
      "output_schema": {
        "profile_fields": [
          "profile_id",
          "mapping_id",
          "displacement_score",
          "net_displacement_pips",
          "friction_threshold_pips",
          "usable_available_pips",
          "extractable",
          "pattern_qualified_opportunity",
          "distance_to_floor_pips",
          "distance_to_ceiling_pips",
          "compression_ratio",
          "velocity_pips_per_sec",
          "acceleration_pips_per_sec2",
          "energy_state",
          "zone_state",
          "time_in_zone_sec",
          "tick_cadence_sec",
          "velocity_pips_per_bar",
          "acceleration_pips_per_bar",
          "impulse_ratio",
          "direction_group",
          "distance_mode",
          "fit_state",
          "discovered_distance_pips",
          "target_distance_bucket",
          "precursor_family_id",
          "topology_family_id",
          "location_relation_id",
          "distance_family_id",
          "energy_family_id",
          "lifecycle_stage",
          "parent_pattern_id",
          "parent_episode_id",
          "opportunity_episode_id",
          "overlap_group_id",
          "episode_position",
          "data_confidence"
        ]
      }
