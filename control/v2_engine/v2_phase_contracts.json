    {
      "phase": "PHASE_1B",
      "name": "Tier 1 Global Truth Kernel",
      "required_outputs": [
        "control/v2_engine/tier1/v2_truth_kernel_plan.json",
        "control/v2_engine/tier1/v2_truth_kernel_inventory.json",
        "control/v2_engine/tier1/v2_phase1_truth_kernel_rows.json"
      ],
      "pass_gates": [
        "truth primitives are emitted before doctrine composition",
        "movement, structure, direction, precursor, energy, quality, and event kernels are explicitly defined",
        "global slots for macro bias, htf zone, and liquidity map are reserved even if unimplemented",
        "doctrine creation is documented as a composition step on top of truth kernels"
      ],
      "output_schema": {
        "truth_kernel_fields": [
          "movement_kernel",
          "structure_kernel",
          "direction_kernel",
          "precursor_kernel",
          "energy_kernel",
          "quality_kernel",
          "event_kernel",
          "global_slots",
          "kernel_signature"
        ]
      }
    },
    {
      "phase": "PHASE_2",
      "name": "Doctrine Formalization And Support Contracts",
      "required_outputs": [
        "control/v2_engine/phase2/v2_phase2_cluster_report.json"
      ],
      "pass_gates": [
        "doctrine ids are deterministic",
        "long and short doctrine logic remain separated",
        "raw opportunity coverage is published before doctrine performance filtering",
        "each doctrine preserves multi-distance expressions",
        "each doctrine publishes a support contract for assignment",
        "each doctrine is run through a global unrestricted extraction simulation",
        "only profitable doctrine survivors are allowed into Tier 2",
        "no asset or pnl fields are used in doctrine features"
      ],
      "output_schema": {
        "doctrine_fields": [
          "doctrine_id",
          "doctrine_state",
          "doctrine_source",
          "legacy_pattern_match_state",
          "direction_group",
          "support_contract",
          "support_core_topology_family_ids",
          "support_core_location_relation_ids",
          "support_core_precursor_states",
          "support_core_energy_states",
          "support_signatures",
          "allowed_target_distance_buckets",
          "allowed_distance_families",
          "distance_expression_count",
          "distance_expressions",
          "tier1_extraction_summary",
          "tier1_survivor"
        ]
      }
    },
    {
      "phase": "PHASE_3",
      "name": "Context Modifiers And Projection Axis",
      "required_outputs": [
        "control/v2_engine/phase3/v2_phase3_context_report.json"
      ],
      "pass_gates": [
        "regime modifier exists",
        "session modifier exists",
        "instrument calibration exists",
        "projection axis exists",
        "doctrine-aware projection layer exists"
      ]
    },
    {
      "phase": "PHASE_4",
      "name": "Convergence Matrix And Trigger Trap",
      "required_outputs": [
        "control/v2_engine/phase4/v2_phase4_trigger_report.json"
      ],
      "pass_gates": [
        "trigger traps have ttl",
        "trigger traps have energy minimum",
        "abort logic is active",
