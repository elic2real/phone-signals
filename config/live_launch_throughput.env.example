# Live Launch Throughput Profile (example)
# Source this file before launch, then override values as needed.
# This profile does NOT include credentials; keep secrets in local .env only.

# Throughput and pair coverage
PAIR_LIST=EUR_USD,GBP_USD,USD_JPY,USD_CHF,AUD_USD,USD_CAD,NZD_USD,EUR_GBP,EUR_JPY,GBP_JPY,EUR_CHF,CHF_JPY,AUD_JPY,NZD_JPY,AUD_CAD
ENFORCE_ENTRY_INVENTORY_SCOPE=0
SUPPRESS_CONTINUATION_ENTRIES=0
NO_TRADE_LIMITERS=0
NO_THROTTLE_MODE=0

# Keep entries enabled unless you intentionally run manage-only.
ALLOW_ENTRIES=1

# Notification behavior
NOTIFY_ENABLE_SEND=1
NOTIFY_DESKTOP_BIN=notify-send
NOTIFY_TERMUX_BIN=termux-notification

# Desktop launch defaults: require desktop backend, termux optional
NOTIFY_REQUIRE_DESKTOP=1
NOTIFY_REQUIRE_TERMUX=0

# Termux launch override: flip these when running on phone
# NOTIFY_REQUIRE_DESKTOP=0
# NOTIFY_REQUIRE_TERMUX=1